# ============================================================
#  Brewfile — the whole toolchain in one command:
#    brew bundle --file=~/dotfiles/Brewfile
#  (install.sh runs this automatically when brew is present)
# ============================================================

# Shell & prompt
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Modern CLI
brew "eza"
brew "bat"
brew "fzf"
brew "zoxide"
brew "fd"
brew "ripgrep"
brew "git-delta"

# Git & workflow
brew "gh"
brew "lazygit"

# Node toolchain
brew "fnm"        # fast Node version manager (auto-switches on cd)
brew "ni"         # picks npm/pnpm/yarn based on the lockfile
brew "direnv"     # per-project env vars, loaded automatically

# Editors & workspaces
brew "neovim"
brew "herdr"      # terminal workspace manager for AI coding agents

# Apps & fonts
cask "ghostty"
cask "font-fira-code-nerd-font"
