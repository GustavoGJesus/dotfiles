#!/usr/bin/env python3
"""Generate Codex custom agents from Claude Code agent files.

Claude Code agents are markdown files whose body is the system prompt and
whose frontmatter preloads skills, restricts tools and enables a memory
folder. Codex wants one TOML file per agent with `name`, `description` and
`developer_instructions`. Rather than copy each prompt (and let the two drift),
every generated TOML is a thin adapter: it tells the Codex agent to read the
markdown file as its role definition, to read the skills the role preloads,
and translates the frontmatter restrictions into instructions, since a Codex
custom agent cannot narrow its own sandbox.

Usage:
  codex-agents-sync --src DIR --dest DIR [--root DIR] [--skills DIR]
                    [--memory DIR] [--check]

  --src     folder with the Claude agents (*.md; README.md is skipped)
  --dest    folder that receives <name>.toml (stale generated files removed)
  --root    paths inside this folder are written relative to it (project use)
  --skills  where SKILL.md folders live (default: ~/.agents/skills)
  --memory  Claude agent-memory folder for `memory:` agents
  --check   exit 1 if any output would change, write nothing
"""
import argparse
import os
import sys

MARKER = "# Generated by codex-agents-sync"

# Codex agents inherit the session's model; a Claude agent pinned to a lighter
# model gets a lower reasoning effort instead, which is Codex's cost lever.
EFFORT = {"haiku": "low", "sonnet": "low", "opus": "high"}


def frontmatter(path):
    with open(path, encoding="utf-8") as f:
        text = f.read()
    if not text.startswith("---\n"):
        return {}
    meta = {}
    for line in text[4:].split("\n---", 1)[0].splitlines():
        if ":" in line and not line.startswith((" ", "\t")):
            key, value = line.split(":", 1)
            meta[key.strip()] = value.strip().strip('"').strip("'")
    return meta


def as_list(value):
    return [item.strip() for item in value.split(",") if item.strip()] if value else []


def toml_string(value):
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def show(path, root):
    path = os.path.abspath(path)
    if root and (path + "/").startswith(root + "/"):
        return os.path.relpath(path, root)
    return path.replace(os.path.expanduser("~"), "~", 1)


def render(md, meta, args):
    name = meta.get("name") or os.path.splitext(os.path.basename(md))[0]
    tools = as_list(meta.get("tools"))
    disallowed = as_list(meta.get("disallowedTools"))
    skills = as_list(meta.get("skills"))
    read_only = {"Edit", "Write"} <= set(disallowed) or bool(tools and not {"Edit", "Write"} & set(tools))
    spawns = "Agent" not in disallowed and (not tools or "Agent" in tools)

    lines = [
        f"You are the `{name}` agent. Your full role definition is `{show(md, args.root)}`: "
        "read that file now, entirely, and follow its body as your system prompt. Its YAML "
        "frontmatter is Claude Code configuration; this file already translates it below.",
        "",
        "Where the role mentions Claude Code tools, use your own equivalent: the Agent tool "
        "means spawning a subagent, the Skill tool means reading a SKILL.md file, and "
        "`.claude/skills/<name>` is the same folder as `.agents/skills/<name>`.",
    ]
    if args.root and os.path.exists(os.path.join(args.root, "AGENTS.md")):
        lines += ["", "Where the role says to read the workspace `CLAUDE.md`, read `AGENTS.md`: "
                  "CLAUDE.md only imports it and adds Claude Code specifics."]
    if skills:
        lines += ["", "Before doing anything else, read these skills in full; the role depends on them:"]
        lines += [f"- `{show(os.path.join(args.skills, s, 'SKILL.md'), args.root)}`" for s in skills]
    if meta.get("memory") and args.memory:
        memory = show(os.path.join(args.memory, name, "MEMORY.md"), args.root)
        lines += ["", f"Your project memory is `{memory}`. Read it at start if it exists, and "
                  "record durable facts there the way the role file describes."]
    if read_only:
        lines += ["", "You are read-only. Never create, edit, move or delete files, never commit "
                  "and never push. Codex cannot narrow the sandbox of a custom agent, so this "
                  "boundary is yours to keep; report what should change instead."]
    elif "Edit" in disallowed:
        lines += ["", "Do not edit existing source files. Write only the new files the role "
                  "names as its output."]
    if not spawns:
        lines += ["", "Do not spawn other agents."]

    body = "\n".join(lines).replace('"""', '\\"\\"\\"')
    return (
        f"{MARKER} from {show(md, args.root)}. Do not edit;\n"
        "# change the markdown file and run the generator again.\n"
        f"name = {toml_string(name)}\n"
        f"description = {toml_string(meta.get('description', ''))}\n"
        + (f"model_reasoning_effort = {toml_string(EFFORT[meta['model']])}\n" if meta.get("model") in EFFORT else "")
        + f'developer_instructions = """\n{body}\n"""\n'
    ), name


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--src", required=True)
    parser.add_argument("--dest", required=True)
    parser.add_argument("--root")
    parser.add_argument("--skills", default=os.path.expanduser("~/.agents/skills"))
    parser.add_argument("--memory")
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    args.root = os.path.abspath(args.root) if args.root else None
    if args.root:
        args.skills = os.path.join(args.root, args.skills) if not os.path.isabs(args.skills) else args.skills
        if args.memory and not os.path.isabs(args.memory):
            args.memory = os.path.join(args.root, args.memory)

    wanted = {}
    for entry in sorted(os.listdir(args.src)):
        md = os.path.join(args.src, entry)
        if not entry.endswith(".md") or entry == "README.md" or not os.path.isfile(md):
            continue
        content, name = render(md, frontmatter(md), args)
        wanted[f"{name}.toml"] = content

    stale = []
    if os.path.isdir(args.dest):
        for entry in os.listdir(args.dest):
            path = os.path.join(args.dest, entry)
            if entry.endswith(".toml") and entry not in wanted:
                with open(path, encoding="utf-8") as f:
                    if f.read().startswith(MARKER):
                        stale.append(path)

    changed = []
    for entry, content in wanted.items():
        path = os.path.join(args.dest, entry)
        current = open(path, encoding="utf-8").read() if os.path.exists(path) else None
        if current != content:
            changed.append(path)
            if not args.check:
                os.makedirs(args.dest, exist_ok=True)
                with open(path, "w", encoding="utf-8") as f:
                    f.write(content)
    for path in stale:
        if not args.check:
            os.remove(path)

    for path in changed + stale:
        print(("out of date: " if args.check else "updated: ") + path)
    if args.check and (changed or stale):
        print("Run codex-agents-sync without --check to regenerate.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
