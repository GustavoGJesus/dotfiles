[user]
	name = GustavoGJesus
	# GitHub's noreply address: this file is public and so is every commit.
	email = 83106838+GustavoGJesus@users.noreply.github.com
[core]
	pager = delta
	excludesFile = ~/.config/git/ignore
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	file-style = "#85dacc"
	file-decoration-style = "#85dacc ul"
	line-numbers-minus-style = "#fd6883"
	line-numbers-plus-style = "#adda78"
	line-numbers-zero-style = "#72696a"
	hunk-header-decoration-style = "#5b5353"
	# Without these, delta picks its own vivid green/red backgrounds,
	# which shout over Ristretto. "syntax" keeps the code highlighted.
	plus-style = "syntax #33402c"
	plus-emph-style = "syntax #4a5c3c"
	minus-style = "syntax #4a2f33"
	minus-emph-style = "syntax #6b3d43"
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default

# ---- automation: the boring parts run themselves ----
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	autoStash = true
	updateRefs = true
[fetch]
	prune = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate

# ---- secrets: gitleaks scans what is staged before every commit ----
# A config-based hook (git 2.54+) runs before, not instead of, the repo's own
# pre-commit hook, so husky and .git/hooks keep working. Skip it in one repo
# with `git config hook.gitleaks.enabled false`.
[hook "gitleaks"]
	event = pre-commit
	command = /opt/homebrew/bin/gitleaks git --pre-commit --staged --redact --verbose --no-banner

# ---- per machine: the commit signing setup, never versioned ----
# user.signingkey, commit.gpgsign, gpg.format and gpg.ssh.allowedSignersFile
# live in ~/.gitconfig.local. install.sh moves them there from an existing
# ~/.gitconfig before linking this file. Kept last so it wins.
[include]
	path = ~/.gitconfig.local
