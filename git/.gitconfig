[user]
	name = GustavoGJesus
	email = gustavogomesdev@proton.me
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	file-style = "#85dacc"
	file-decoration-style = "#85dacc ul"
	line-numbers-minus-style = "#fd6883"
	line-numbers-plus-style = "#adda78"
	line-numbers-zero-style = "#72696a"
	hunk-header-decoration-style = "#5b5353"
	# Without these, delta picks its own vivid green/red backgrounds,
	# which shout over Ristretto. "syntax" keeps the code highlighted.
	plus-style = "syntax #33402c"
	plus-emph-style = "syntax #4a5c3c"
	minus-style = "syntax #4a2f33"
	minus-emph-style = "syntax #6b3d43"
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default

# ---- automation: the boring parts run themselves ----
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	autoStash = true
	updateRefs = true
[fetch]
	prune = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
