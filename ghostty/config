# =========================================================
# Ghostty — visual configuration
# Path: ~/Library/Application Support/com.mitchellh.ghostty/config
# Docs: https://ghostty.org/docs/config  (every option)
# Reload without closing: Cmd+Shift+, (reload config)
# =========================================================

# ---------------------------------------------------------
# THEME
# ---------------------------------------------------------
# Tokyo Night (#1a1b26 background). Swap it for any theme from:
#   ghostty +list-themes   (live preview in the terminal)
theme = TokyoNight Night

# Default text in pure white — Tokyo Night's stock foreground (#c0caf5)
# reads bluish; this override wins over the theme's foreground and is what
# actually paints unstyled text everywhere (shell, Claude Code chat body).
foreground = #ffffff

# ---------------------------------------------------------
# FONT
# ---------------------------------------------------------
font-family = FiraCode Nerd Font Mono
font-size = 12

# Crisper, fuller text on macOS (Retina)
font-thicken = true

# Vertical breathing room between lines (reading comfort)
adjust-cell-height = 10%

# Ligatures (=>  ===  !=  ->) are ON by default.
# To turn them OFF, uncomment the line below:
# font-feature = -calt, -liga, -dlig

# ---------------------------------------------------------
# COLORS / TRANSPARENCY
# ---------------------------------------------------------
# More vivid colors on Apple displays (P3)
window-colorspace = display-p3

# Modern frosted glass: transparency + blur
background-opacity = 0.92
background-blur = 20

# Unfocused splits dim slightly (helps you focus)
unfocused-split-opacity = 0.85

# ---------------------------------------------------------
# CURSOR
# ---------------------------------------------------------
cursor-style = bar
cursor-style-blink = true

# ---------------------------------------------------------
# WINDOW / macOS
# ---------------------------------------------------------
macos-titlebar-style = transparent

# Inner padding (the window "breathes")
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-padding-color = extend

# Option becomes Alt (⌥ works for terminal shortcuts)
macos-option-as-alt = true

# Hide the mouse pointer while typing
mouse-hide-while-typing = true

# New tab/window opens in the same directory
window-inherit-working-directory = true

# ---------------------------------------------------------
# BEHAVIOR
# ---------------------------------------------------------
# Mouse selection copies straight to the clipboard
copy-on-select = clipboard

# Fine, web-page-like scrolling: the trackpad is already 1:1 (precision);
# a physical mouse wheel scrolled 3 lines per tick by default — now 1.
mouse-scroll-multiplier = precision:1,discrete:1

# ---------------------------------------------------------
# QUICK TERMINAL (global dropdown, iTerm/Yakuake style)
# ---------------------------------------------------------
# Slides down from the top, over any app.
quick-terminal-position = top
quick-terminal-animation-duration = 0.12
# Global shortcut: ⌘ + ` (backtick). Needs Accessibility permission
# (macOS asks on first use: Settings > Privacy > Accessibility > Ghostty).
keybind = global:cmd+grave_accent=toggle_quick_terminal

# ---------------------------------------------------------
# EXTRA SHORTCUTS
# ---------------------------------------------------------
# Splits, tabs and navigation ship by default:
#   ⌘D split right · ⌘⇧D split below · ⌘[ / ⌘] navigate
#   ⌘⇧Enter zoom · ⌘⌃arrows resize · ⌘T new tab
# Reload config: ⌘⇧,   ·   Font size up/down: ⌘+ / ⌘-
